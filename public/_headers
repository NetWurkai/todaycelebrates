# Submitted occasions (E6): the directory and one page per paid listing.
# Shorter window than the observance pages -- a listing that is withdrawn or
# rejected should leave the edge quickly, because it is the one page type
# whose removal is time-sensitive.
/occasions/*
  Cache-Control: public, max-age=600, stale-while-revalidate=3600

/
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# Calendar feeds (E5). Content-Type is stated rather than inferred: a feed
# served as text/plain or application/octet-stream opens in a text editor
# instead of a calendar app, and the subscribe flow fails silently. The cache
# window matches the pages -- the feeds are regenerated on the same daily run.
/calendar.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/category/*/calendar.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/holiday/*/event.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Share cards (E7): the card.png written beside an observance, date,
# year-index or category page, used as that page's og:image. Cached harder
# than the page because the image changes only when its subject does -- and
# like the .ics rule above, each of these sits after its page's own rule
# deliberately, so the more specific rule is the one that wins. All of them
# match nothing until SHARE_CARDS is turned on.
/holiday/*/card.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/day/*/card.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/holidays/*/card.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/category/*/card.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The perennial cards need one rule per month for the same reason the pages
# above do: their paths are /<month>-<day>/, so there is no single prefix that
# reaches them without also catching every other page. Each of these sits
# after its month's page rule, so the card gets the card cache and not the
# page's shorter one.
/january-*/card.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

