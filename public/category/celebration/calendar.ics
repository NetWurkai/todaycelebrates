BEGIN:VEVENT
UID:oktoberfest-starts-in-germany-20270918@todaycelebrates.com
DTSTAMP:20261014T000000Z
DTSTART;VALUE=DATE:20270918
DTEND;VALUE=DATE:20270919
SUMMARY:Oktoberfest (starts in Germany)
DESCRIPTION:Oktoberfest opens in Munich on the Saturday fifteen days before
